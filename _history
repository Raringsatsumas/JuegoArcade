typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><value name=\"tile\"><shadow type=\"tileset_tile_picker\"><field name=\"tile\">assets.tile`myTile`</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_location\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"tiles.Location\"></mutation><field name=\"VALUE\">location</field></block></value><statement name=\"HANDLER\"><block type=\"gameOver2\"><comment pinned=\"false\" h=\"80\" w=\"160\">Termina el juego indicando que el jugador perdió.</comment><value name=\"win\"><shadow type=\"toggleWinLose\"><field name=\"win\">false</field></shadow></value><next><block type=\"game_setgameovereffect\"><field name=\"effect\">effects.blizzard</field><comment pinned=\"false\" h=\"80\" w=\"160\">Muestra un efecto visual de \"blizzard\"\ncuando ocurre la derrota.</comment><value name=\"win\"><shadow type=\"toggleWinLose\"><field name=\"win\">false</field></shadow></value></block></next></block></statement></block><block type=\"spriteshittile\" x=\"-12\" y=\"912\"><comment pinned=\"false\" h=\"80\" w=\"160\">---------------------------------------------------------\n3. EVENTO: EL JUGADOR TOCA EL PORTAL\n---------------------------------------------------------\nEsta función se ejecuta cuando el jugador\ntoca el tile del portal.\nDetecta cuando el jugador toca el tile \"portal\".</comment><value name=\"HANDLER_DRAG_PARAM_sprite\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"Sprite\"></mutation><field name=\"VALUE\">sprite2</field></block></value><value name=\"kind\"><shadow type=\"spritekind\"><field name=\"MEMBER\">Player</field></shadow></value><value name=\"tile\"><shadow type=\"tileset_tile_picker\"><field name=\"tile\">assets.tile`portal`</field></shadow></value><value name=\"HANDLER_DRAG_PARAM_location\"><block type=\"argument_reporter_custom\" deletable=\"false\"><mutation typename=\"tiles.Location\"></mutation><field name=\"VALUE\">location2</field></block></value><statement name=\"HANDLER\"><block type=\"gameOver2\"><comment pinned=\"false\" h=\"80\" w=\"160\">Termina el juego indicando que el jugador ganó.</comment><value name=\"win\"><shadow type=\"toggleWinLose\"><field name=\"win\">true</field></shadow></value><next><block type=\"game_setgameovereffect\"><field name=\"effect\">effects.clouds</field><comment pinned=\"false\" h=\"80\" w=\"160\">Muestra un efecto visual de nubes\ncuando ocurre la victoria.</comment><value name=\"win\"><shadow type=\"toggleWinLose\"><field name=\"win\">true</field></shadow></value></block></next></block></statement></block></xml>","main.ts":"","README.md":" ","assets.json":"","main.py":"# ---------------------------------------------------------\n# 1. EVENTO: EL JUGADOR TOCA LA LAVA\n# ---------------------------------------------------------\n# Esta función se ejecuta cuando el jugador toca\n# una casilla específica del mapa.\n# Detecta cuando un sprite de tipo Player\n# toca el tile llamado \"myTile\".\n# En este juego, \"myTile\" representa la lava.\n\ndef on_overlap_tile(sprite, location):\n    # Termina el juego indicando que el jugador perdió.\n    game.game_over(False)\n    # Muestra un efecto visual de \"blizzard\"\n    # cuando ocurre la derrota.\n    game.set_game_over_effect(False, effects.blizzard)\nscene.on_overlap_tile(SpriteKind.player,\n    assets.tile(\"\"\"\n        myTile\n        \"\"\"),\n    on_overlap_tile)\n\n# ---------------------------------------------------------\n# 2. EVENTO: PRESIONAR EL BOTÓN A PARA SALTAR\n# ---------------------------------------------------------\n# Esta función se ejecuta cuando se presiona el botón A.\n# Conecta el botón A con la función de salto.\n\ndef on_a_pressed():\n    # Revisa si el jugador está quieto verticalmente.\n    # vy = velocidad vertical.\n    # Si vy vale 0, significa que no está subiendo\n    # ni bajando en ese momento.\n    if Rosado.vy == 0:\n        # Una velocidad vertical negativa hace\n        # que el personaje suba.\n        # Por eso -100 produce el salto.\n        Rosado.vy = -100\ncontroller.A.on_event(ControllerButtonEvent.PRESSED, on_a_pressed)\n\n# ---------------------------------------------------------\n# 3. EVENTO: EL JUGADOR TOCA EL PORTAL\n# ---------------------------------------------------------\n# Esta función se ejecuta cuando el jugador\n# toca el tile del portal.\n# Detecta cuando el jugador toca el tile \"portal\".\n\ndef on_overlap_tile2(sprite2, location2):\n    # Termina el juego indicando que el jugador ganó.\n    game.game_over(True)\n    # Muestra un efecto visual de nubes\n    # cuando ocurre la victoria.\n    game.set_game_over_effect(True, effects.clouds)\nscene.on_overlap_tile(SpriteKind.player,\n    assets.tile(\"\"\"\n        portal\n        \"\"\"),\n    on_overlap_tile2)\n\nRosado: Sprite = None\n# Cambia el color de fondo de la escena.\nscene.set_background_color(11)\n# Crea el sprite del jugador.\n# La imagen está formada por una cuadrícula de píxeles.\nRosado = sprites.create(img(\"\"\"\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . 3 3 3 3 . . . . . .\n        . . . . . 3 3 . . 3 3 . . . . .\n        . . . . 3 3 . . . . 3 . . . . .\n        . . . . 3 . . . . . . 3 . . . .\n        . . . 3 3 . . . . . . 3 3 . . .\n        . . 3 3 . . . . . . . . 3 . . .\n        . 3 3 . . . . . . . . . 3 . . .\n        . . 3 3 . . . . . . . . 3 . . .\n        . . . 3 3 . 3 3 3 . . . 3 . . .\n        . . . . 3 3 3 . 3 3 3 3 3 . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        . . . . . . . . . . . . . . . .\n        \"\"\"),\n    SpriteKind.player)\n# Indica que este sprite pertenece\n# a la categoría Player.\n# ---------------------------------------------------------\n# 5. MOVIMIENTO DEL JUGADOR\n# ---------------------------------------------------------\n# Permite mover al jugador usando los botones.\n# \n# 100 = velocidad horizontal.\n# 0 = no se permite movimiento vertical con los botones.\n# \n# El movimiento vertical se controla mediante el salto\n# y la gravedad.\ncontroller.move_sprite(Rosado, 100, 0)\n# ---------------------------------------------------------\n# 6. CARGAR EL MAPA\n# ---------------------------------------------------------\n# Carga el tilemap llamado \"level1\".\n# El tilemap contiene el escenario del juego:\n# suelo, paredes, lava, portal, etc.\ntiles.set_current_tilemap(tilemap(\"\"\"\n    level1\n    \"\"\"))\n# 7. GRAVEDAD\n# ay significa \"aceleración en el eje Y\".\n# Como el valor es positivo, el personaje\n# es empujado hacia abajo constantemente.\n# \n# Esto simula la gravedad.\nRosado.ay = 200\n# 8. CÁMARA\n# Hace que la cámara siga al jugador mientras se mueve.\nscene.camera_follow_sprite(Rosado)","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAAAIAIiIiIiggAgAiUiIiKCACBVJSIiIogAAkUkIiIiKABSRCIiIiIoAFAEIiIiIigAIAQgIiKCKAAAIiAiIoIoACACUCIiIoIAAFBVJCIiggIAUEUkIoKCIiJVRCIigoIiIkUkIiKIggJQRCAiIiiCAEJEICIiKCIgQiQgIiIiIg==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"myTile\"\n    },\n    \"tile2\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAUAUAAABVVTMzUwAAVTMzc3c3BVA1A4eIiDcFNXNwSESLNwU1d4dIRIR3UzWHiEuIi3hTNYeIiHh3eDM1d3d3d3N3MzUzMzNTNTNTVVVVVQAAVQUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName